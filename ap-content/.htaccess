# AgoraPress content directory — runtime data protection for live installs.
# Themes/plugins are loaded via include from the front controller, not via
# direct HTTP. Uploads have their own rules under uploads/.

Options -Indexes

# Never serve SQLite / DB files if placed under ap-content/ (installer default).
<FilesMatch "(?i)\.(sqlite3?|db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
