{
    "name": "extrovertednerd/agorapress",
    "description": "Lightweight free-forever CMS with integrated forums. Spiritual successor to classic WordPress + phpBB.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "cms",
        "blog",
        "forum",
        "php",
        "agorapress"
    ],
    "homepage": "https://agorapress.extrovertednerd.com",
    "support": {
        "docs": "https://agorapress.extrovertednerd.com",
        "source": "https://github.com/ExtrovertedNerd/AgoraPress"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "suggest": {
        "ext-pdo_mysql": "Primary database driver (MySQL 8+ / MariaDB 10.6+)",
        "ext-pdo_sqlite": "Zero-config SQLite support",
        "ext-pdo_pgsql": "PostgreSQL support",
        "ext-gd": "Image processing (or install ext-imagick)",
        "ext-imagick": "Image processing alternative to gd",
        "ext-intl": "Improved internationalization (recommended)"
    },
    "autoload": {
        "classmap": [
            "ap-includes/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AgoraPress\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:structure": "php tests/Structure/assert-structure.php",
        "cs": "phpcs",
        "cs:check": "phpcs",
        "cs:fix": "phpcbf"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
