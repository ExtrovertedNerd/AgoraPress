# AgoraPress .gitignore
#
# Critical: Never include Hephaestus process state (constitution, TODO, Workflow).
# The forge owns TARGET/.hephaestus/; it must never appear in product commits.
.hephaestus/
**/.hephaestus/

# OS / Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# PHP / Composer
/vendor/
composer.lock
.phpunit.result.cache
.phpcs.cache
.php-cs-fixer.cache
.phpstan.cache

# Environment & Config (generated by installer — never commit secrets)
ap-config.php
.env
.env.local
.env.*.local

# Uploads & runtime (SPEC: ap-content/uploads is runtime data)
/ap-content/uploads/
/content/uploads/
*.log

# Node (if any frontend tooling later)
node_modules/
npm-debug.log*
yarn-error.log*

# Build / Cache
/cache/
/tmp/
/temp/
*.cache

# Release packaging artifacts (php bin/package-release.php)
/dist/

# Tests & coverage
/coverage/
.phpunit.cache/
.pytest_cache/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.tox/
htmlcov/
.coverage
.coverage.*

# Docker overrides (local secrets / port maps)
docker-compose.override.yml

# Misc
*.bak
*.tmp
*.temp
*.orig
*.rej
